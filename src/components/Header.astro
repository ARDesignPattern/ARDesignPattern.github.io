---
import { site } from "../data/site";
import { ui, type Locale } from "../i18n/ui";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { localizePath } from "../i18n/utils";

interface Props {
  lang?: Locale;
}

const { lang = "en" } = Astro.props;
const t = ui[lang];
---

<header class="site-header" id="site-header">
  <div class="header-inner">
    <a class="brand" href={localizePath("/", lang)} aria-label="Yu Liu home">
      {site.name}
    </a>

    <div class="header-right">
      <nav class="nav">
        <a class="nav-link" href={localizePath("/#work", lang)}>
          {t.nav.work}
        </a>

        <a class="nav-link" href={localizePath("/about/", lang)}>
          {t.nav.about}
        </a>

        <a class="nav-link" href={localizePath("/#research", lang)}>
          {t.nav.research}
        </a>

        <a class="nav-link" href={localizePath("/#contact", lang)}>
          {t.nav.contact}
        </a>
      </nav>

      <LanguageSwitcher lang={lang} />
    </div>
  </div>
</header>

<style>
  .header-right {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 2rem);
    pointer-events: auto;
  }

  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;

    padding-top: 1.25rem;
    padding-bottom: 1.1rem;

    background: rgba(10, 10, 10, 0);
    border-bottom: 1px solid transparent;

    backdrop-filter: blur(0px);
    -webkit-backdrop-filter: blur(0px);

    transition:
      background 350ms ease,
      border-color 350ms ease,
      backdrop-filter 350ms ease,
      -webkit-backdrop-filter 350ms ease;

    pointer-events: none;
  }

  .site-header.is-scrolled {
    background: rgba(27, 27, 27, 0.5);
    border-bottom-color: rgba(201, 201, 201, 0.8);

    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .header-inner {
    width: 100%;
    padding-inline: var(--page-padding);

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .brand,
  .nav {
    pointer-events: auto;
  }

  .brand {
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 2rem);
  }

  .nav-link {
    position: relative;
    font-size: var(--text-sm);
    color: var(--muted);

    transition: color var(--transition-fast);
  }

  .nav-link::after {
    content: "";

    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.25rem;

    height: 1px;

    background: currentColor;

    transform: scaleX(0);
    transform-origin: right;

    transition: transform var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--text);
  }

  .nav-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  @media (max-width: 768px) {
    .site-header {
      padding-top: 1rem;
      padding-bottom: 0.9rem;
    }

    .nav {
      gap: 0.9rem;
    }

    .nav-link {
      font-size: 0.78rem;
    }
  }

  @media (max-width: 560px) {
    .nav-link:nth-child(2),
    .nav-link:nth-child(3) {
      display: none;
    }
  }
</style>
