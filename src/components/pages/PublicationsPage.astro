---
import Header from "../Header.astro";
import Footer from "../Footer.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import publicationsData from "../../data/publications.json";
import { type Locale } from "../../i18n/ui";
import "../../styles/global.css";

interface Props {
  lang?: Locale;
}

interface Publication {
  slug?: string;
  year: string;
  title: string;
  authors: string[];
  venue: string;
  type: string;
  doi?: string;
  url?: string;
  image?: string;
  abstract?: string;
  topics?: string[];
}

const { lang = "en" } = Astro.props;

const publications = publicationsData as Publication[];

const groupedPublications = publications.reduce<Record<string, Publication[]>>(
  (groups, publication) => {
    if (!groups[publication.year]) {
      groups[publication.year] = [];
    }

    groups[publication.year].push(publication);

    return groups;
  },
  {},
);

const years = Object.keys(groupedPublications).sort(
  (a, b) => Number(b) - Number(a),
);
---

<BaseLayout
  title="Publications — Yu Liu"
  description="Selected publications by Yu Liu in HCI, XR, interaction design, museum technology, and immersive experiences."
  lang={lang}
>
  <Header lang={lang} />

  <main class="publications-page">
    <section class="publications-hero">
      <div class="container">
        <p class="eyebrow">Publications</p>

        <h1 class="publications-title">
          Selected research in HCI, XR, interaction design, and immersive museum
          experiences.
        </h1>
      </div>
    </section>

    <section class="publications-list">
      <div class="container">
        {
          years.map((year) => (
            <div class="publication-year-group">
              <div class="publication-year">
                <p class="eyebrow">{year}</p>
              </div>

              <div class="publication-items">
                {groupedPublications[year].map((publication) => (
                  <article class="publication-item">
                    <p class="publication-meta">
                      {publication.venue} · {publication.year}
                    </p>

                    <h2>{publication.title}</h2>

                    <p class="publication-authors">
                      {publication.authors.join(", ")}
                    </p>

                    <div class="publication-links">
                      {publication.slug && (
                        <a
                          href={`https://yuliu.design/ar-interaction-patterns/literature.html#${publication.slug}`}
                        >
                          Abstract
                        </a>
                      )}

                      {publication.doi && (
                        <a
                          href={`https://doi.org/${publication.doi}`}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          DOI
                        </a>
                      )}
                    </div>
                  </article>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .publications-page {
    min-height: 100vh;
    padding-top: 7rem;
  }

  .publications-hero {
    padding-block: clamp(4rem, 8vw, 9rem);
  }

  .publications-title {
    max-width: 16ch;
    margin: 1.5rem 0 0;
    font-size: clamp(3rem, 7vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
    font-weight: 600;
  }

  .publications-list {
    padding-bottom: var(--section-gap);
  }

  .publication-year-group {
    display: grid;
    grid-template-columns: minmax(7rem, 0.25fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    padding-block: 3rem;
    border-top: 1px solid var(--line);
  }

  .publication-items {
    display: grid;
  }

  .publication-item {
    padding: 0 0 3rem;
  }

  .publication-item + .publication-item {
    padding-top: 3rem;
    border-top: 1px solid var(--line);
  }

  .publication-item h2 {
    max-width: 46ch;
    margin: 0.45rem 0 0.75rem;
    font-size: clamp(1.35rem, 2vw, 2rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
    font-weight: 500;
  }

  .publication-meta {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .publication-authors {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .publication-links {
    display: flex;
    gap: 1rem;
    margin-top: 0.85rem;
  }

  .publication-links a {
    color: var(--text);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .publication-item {
    padding: 0 0 2rem;
  }

  .publication-item + .publication-item {
    padding-top: 2rem;
  }

  .publication-authors,
  .publication-venue {
    margin: 0 0 0.5rem;
    color: var(--muted);
    line-height: 1.5;
  }

  .publication-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .publication-links a {
    color: var(--text);
    text-decoration: none;
  }

  .publication-links a:hover {
    opacity: 0.65;
  }

  @media (max-width: 768px) {
    .publications-page {
      padding-top: 5rem;
    }

    .publication-year-group {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
