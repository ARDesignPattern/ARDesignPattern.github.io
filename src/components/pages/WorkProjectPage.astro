---
import Header from "../Header.astro";
import Footer from "../Footer.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SpatialGallery from "../SpatialGallery.astro";
import ProjectVideo from "../ProjectVideo.astro";
import ProjectCredits from "../ProjectCredits.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { localizePath } from "../../i18n/utils";
import { type Locale } from "../../i18n/ui";
import "../../styles/global.css";

interface Props {
  project: CollectionEntry<"projects">;
  lang?: Locale;
}

const { project, lang = "en" } = Astro.props;

const data = project.data;

const projects = await getCollection("projects");

function getProjectById(id?: string) {
  if (!id) return undefined;
  return projects.find((item) => item.id === id);
}

const previousProject = getProjectById(data.previous);
const nextProject = getProjectById(data.next);

const infoItems = [
  {
    label: "Context",
    value: data.context,
  },
  {
    label: "Platform",
    value: data.platform,
  },
  {
    label: "Interaction",
    value: data.interaction,
  },
  {
    label: "Focus",
    value: data.focus,
  },
].filter((item) => item.value);
---

<BaseLayout
  title={`${data.title} — Yu Liu`}
  description={data.description}
  lang={lang}
>
  <Header lang={lang} />

  <main class="work-project-page">
    <!-- HERO -->
    <section class="work-hero">
      <div class="work-container">
        <h1>{data.title}</h1>

        {data.subtitle && <p class="work-subtitle">{data.subtitle}</p>}

        {
          data.tags && data.tags.length > 0 && (
            <div class="work-tags">
              {data.tags.map((tag) => (
                <span>{tag}</span>
              ))}
            </div>
          )
        }
      </div>
    </section>

    <!-- GALLERY -->
    {
      data.gallery && data.gallery.length > 0 && (
        <section class="work-gallery-section">
          <SpatialGallery items={data.gallery} />
        </section>
      )
    }

    <!-- VIDEO -->
    {
      data.video && (data.video.youtube || data.video.bilibili) && (
        <section class="work-video-section">
          <div class="work-container">
            <ProjectVideo video={data.video} />
          </div>
        </section>
      )
    }

    <!-- PROJECT INFO -->
    <section class="work-info-section">
      <div class="work-container">
        <div class="work-info-grid">
          {
            infoItems.map((item) => (
              <div class="work-info-item">
                <p class="work-info-label">{item.label}</p>

                <p class="work-info-value">{item.value}</p>
              </div>
            ))
          }
        </div>

        {
          data.credits?.role && data.credits.role.length > 0 && (
            <div class="work-outcome">
              <p class="work-info-label">My Role</p>
              <p>{data.credits.role.join(" · ")}</p>
            </div>
          )
        }

        {
          data.credits && (
            <div class="work-credits-wrapper">
              <ProjectCredits credits={data.credits} />
            </div>
          )
        }
      </div>
    </section>

    <!-- BOTTOM NAV -->
    <section class="work-project-nav">
      <div class="work-container">
        <div class="work-project-nav-grid">
          <div>
            {
              previousProject && (
                <a
                  class="work-nav-link"
                  href={localizePath(`/projects/${previousProject.id}/`, lang)}
                >
                  <span class="work-nav-label">Previous Project</span>
                  <span class="work-nav-title">
                    ← {previousProject.data.title}
                  </span>
                </a>
              )
            }
          </div>

          <a class="work-back-link" href={localizePath("/#work", lang)}>
            Back to Work
          </a>

          <div class="work-nav-next">
            {
              nextProject && (
                <a
                  class="work-nav-link"
                  href={localizePath(`/projects/${nextProject.id}/`, lang)}
                >
                  <span class="work-nav-label">Next Project</span>
                  <span class="work-nav-title">{nextProject.data.title} →</span>
                </a>
              )
            }
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .work-project-page {
    min-height: 100vh;
    padding-top: 7rem;
    background: #000;
    color: #fff;
  }
  .work-credits-wrapper {
    margin-top: clamp(4rem, 7vw, 7rem);
  }
  .work-container {
    width: min(calc(100% - (var(--page-padding) * 2)), 1480px);
    margin-inline: auto;
  }

  /* =========================
     HERO
     ========================= */

  .work-hero {
    padding: clamp(5rem, 9vw, 10rem) 0 clamp(4rem, 7vw, 7rem);
  }

  .work-hero h1 {
    max-width: 12ch;
    margin: 0;

    font-size: clamp(4rem, 9vw, 9rem);
    line-height: 0.88;
    letter-spacing: -0.06em;
    font-weight: 600;
  }

  .work-subtitle {
    max-width: 42rem;
    margin: 2rem 0 0;

    color: rgba(255, 255, 255, 0.68);
    font-size: clamp(1.05rem, 1.4vw, 1.35rem);
    line-height: 1.5;
  }

  .work-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;

    margin-top: 2rem;
  }

  .work-tags span {
    padding: 0.45rem 0.75rem;

    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;

    color: rgba(255, 255, 255, 0.65);
    font-size: 0.8rem;
    line-height: 1;
  }

  /* =========================
     GALLERY
     ========================= */

  .work-gallery-section {
    padding: 0 0 clamp(7rem, 12vw, 12rem);
    overflow: hidden;
  }

  /* =========================
     VIDEO
     ========================= */

  .work-video-section {
    padding-bottom: clamp(7rem, 12vw, 12rem);
  }

  /* =========================
     INFO
     ========================= */

  .work-info-section {
    padding-bottom: clamp(7rem, 12vw, 12rem);
  }

  .work-info-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .work-info-item {
    min-height: 10rem;
    padding: 1.5rem 1.5rem 2rem 0;

    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  .work-info-label {
    margin: 0 0 1rem;

    color: rgba(255, 255, 255, 0.4);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .work-info-value {
    max-width: 28rem;
    margin: 0;

    color: rgba(255, 255, 255, 0.82);
    font-size: 1rem;
    line-height: 1.6;
  }

  .work-outcome {
    max-width: 60rem;
    margin-top: 3rem;
  }

  .work-outcome p:last-child {
    margin: 0;

    color: rgba(255, 255, 255, 0.82);
    font-size: clamp(1.3rem, 2.3vw, 2.2rem);
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  /* =========================
     PROJECT NAV
     ========================= */

  .work-project-nav {
    padding: 3rem 0 5rem;

    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .work-project-nav-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 2rem;
    align-items: end;
  }

  .work-nav-link {
    display: inline-grid;
    gap: 0.5rem;
    text-decoration: none;
  }

  .work-nav-label {
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .work-nav-title {
    color: rgba(255, 255, 255, 0.8);
    font-size: 1rem;

    transition: color var(--transition-fast);
  }

  .work-nav-link:hover .work-nav-title {
    color: #fff;
  }

  .work-nav-next {
    text-align: right;
  }

  .work-back-link {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.85rem;
    text-decoration: none;
  }

  .work-back-link:hover {
    color: #fff;
  }

  /* =========================
     TABLET
     ========================= */

  @media (max-width: 900px) {
    .work-info-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* =========================
     MOBILE
     ========================= */

  @media (max-width: 768px) {
    .work-project-page {
      padding-top: 5rem;
    }

    .work-hero {
      padding-top: 4rem;
    }

    .work-hero h1 {
      max-width: none;
      font-size: clamp(3rem, 15vw, 5.5rem);
      line-height: 0.92;
    }

    .work-info-grid {
      grid-template-columns: 1fr;
    }

    .work-info-item {
      min-height: auto;
      padding: 1.5rem 0;
    }

    .work-project-nav-grid {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .work-nav-next {
      text-align: left;
    }

    .work-back-link {
      order: 3;
      margin-top: 1rem;
    }
  }
</style>
