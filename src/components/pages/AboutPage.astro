---
import Header from "../Header.astro";
import Footer from "../Footer.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../data/site";
import { ui, type Locale } from "../../i18n/ui";
import "../../styles/global.css";

interface Props {
  lang?: Locale;
}

const { lang = "en" } = Astro.props;
const t = ui[lang];
---

<BaseLayout
  title="About Yu Liu — Interaction Designer & HCI/XR Researcher"
  description="Yu Liu is an interaction designer and HCI/XR researcher working across spatial computing, prototyping, user research, and real-world deployment."
  lang={lang}
  alternateLanguages={[
    { lang: "en", href: "/about/" },
    { lang: "de", href: "/de/about/" },
    { lang: "zh-Hans", href: "/zh/about/" },
  ]}
>
  <Header lang={lang} />

  <main class="about-page">
    <!-- HERO -->
    <section class="about-hero">
      <div class="container">
        <p class="eyebrow">{t.about.eyebrow}</p>

        <h1 class="about-title">
          {t.about.title}
        </h1>

        <p class="about-intro">
          {t.about.intro}
        </p>
      </div>
    </section>

    <!-- BACKGROUND -->
    <section class="about-section">
      <div class="container about-grid">
        <div>
          <p class="eyebrow">{t.about.backgroundTitle}</p>
        </div>

        <div class="about-copy about-copy-large">
          <p>{t.about.backgroundBody}</p>
        </div>
      </div>
    </section>

    <!-- WHAT I DO -->
    <section class="about-section">
      <div class="container about-grid">
        <div>
          <p class="eyebrow">{t.about.workTitle}</p>
        </div>

        <div class="about-copy">
          <p>{t.about.workBody}</p>

          <div class="about-capabilities">
            <span>Interaction Design</span>
            <span>HCI / User Research</span>
            <span>XR / Spatial Computing</span>
            <span>Prototyping</span>
            <span>Field Deployment</span>
            <span>Design Research</span>
          </div>
        </div>
      </div>
    </section>

    <!-- RESEARCH & PRACTICE -->
    <section class="about-section">
      <div class="container about-grid">
        <div>
          <p class="eyebrow">{t.about.practiceTitle}</p>
        </div>

        <div class="about-copy">
          <p>{t.about.practiceBody}</p>

          <div class="experience-list">
            <div class="experience-row">
              <span>Research</span>
              <p>Hochschule RheinMain · presentXR · LoGaCulture</p>
            </div>

            <div class="experience-row">
              <span>Industry</span>
              <p>ZEISS / tooz · Bosch · Music Tribe</p>
            </div>

            <div class="experience-row">
              <span>Methods</span>
              <p>
                Research through Design · Design Science Research · mixed-method
                evaluation · field studies
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- APPROACH -->
    <section class="about-section">
      <div class="container about-grid">
        <div>
          <p class="eyebrow">{t.about.approachTitle}</p>
        </div>

        <div class="about-copy about-copy-large">
          <p>{t.about.approachBody}</p>
        </div>
      </div>
    </section>

    <!-- CONNECT -->
    <section class="about-section about-connect">
      <div class="container about-grid">
        <div>
          <p class="eyebrow">{t.about.contactTitle}</p>
        </div>

        <div>
          <p class="contact-lead">
            {t.about.contactLead}
          </p>

          <div class="profile-links">
            <a
              class="profile-link"
              href="/documents/Yu_Liu_CV.pdf"
              target="_blank"
              rel="noopener"
            >
              <span>Curriculum Vitae</span>
              <span>PDF · Last updated Sep 2026 ↗</span>
            </a>

            <a
              class="profile-link"
              href="https://www.linkedin.com/in/%E5%AE%87-%E5%88%98-7b4174104/"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>LinkedIn</span>
              <span>Profile ↗</span>
            </a>

            <a
              class="profile-link"
              href="https://orcid.org/0009-0008-4319-5692"
              target="_blank"
              rel="me noopener noreferrer"
            >
              <span>ORCID</span>
              <span>0009-0008-4319-5692 ↗</span>
            </a>

            <a class="profile-link" href={`mailto:${site.email}`}>
              <span>Email</span>
              <span>{site.email} ↗</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .about-page {
    padding-top: 7rem;
  }

  .about-hero {
    padding-block: clamp(4rem, 9vw, 9rem);
  }

  .about-title {
    max-width: 15ch;
    margin: 1.5rem 0 2rem;
    font-size: clamp(3.2rem, 7vw, 7.5rem);
    line-height: 0.95;
    letter-spacing: -0.055em;
    font-weight: 600;
  }

  .about-intro {
    max-width: 44rem;
    margin: 0;
    font-size: var(--text-md);
    line-height: 1.35;
    color: var(--muted);
  }

  .about-section {
    padding-block: clamp(4rem, 8vw, 8rem);
    border-top: 1px solid var(--line);
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(10rem, 0.7fr) minmax(0, 1.8fr);
    gap: clamp(2rem, 6vw, 7rem);
  }

  .about-copy {
    max-width: 48rem;
  }

  .about-copy-large {
    max-width: 54rem;
  }

  .about-copy p {
    margin: 0;
    font-size: var(--text-body);
    line-height: 1.7;
    color: var(--muted);
  }

  /* CAPABILITIES */

  .about-capabilities {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2rem;
  }

  .about-capabilities span {
    padding: 0.55rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 999px;

    color: var(--muted);

    font-size: var(--text-xs);
    line-height: 1;
  }

  /* EXPERIENCE */

  .experience-list {
    margin-top: 3rem;
    border-top: 1px solid var(--line);
  }

  .experience-row {
    display: grid;
    grid-template-columns: minmax(6rem, 0.45fr) minmax(0, 1.55fr);
    gap: 2rem;

    padding-block: 1.4rem;

    border-bottom: 1px solid var(--line);
  }

  .experience-row span {
    color: var(--muted);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .experience-row p {
    margin: 0;
    color: var(--text);
    line-height: 1.5;
  }

  /* CONNECT */

  .contact-lead {
    max-width: 36rem;
    margin: 0 0 2.5rem;

    font-size: var(--text-md);
    line-height: 1.35;
  }

  .profile-links {
    max-width: 48rem;
    border-top: 1px solid var(--line);
  }

  .profile-link {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    align-items: center;

    padding-block: 1.3rem;

    border-bottom: 1px solid var(--line);

    color: var(--text);
    text-decoration: none;

    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  .profile-link span:last-child {
    color: var(--muted);
    font-size: var(--text-xs);
  }

  .profile-link:hover {
    opacity: 0.65;
    transform: translateX(4px);
  }

  /* MOBILE */

  @media (max-width: 768px) {
    .about-page {
      padding-top: 5rem;
    }

    .about-title {
      max-width: none;
    }

    .about-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .experience-row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .profile-link {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }
</style>
