---
import { render } from "astro:content";

import Header from "../Header.astro";
import Footer from "../Footer.astro";
import ProjectCredits from "../ProjectCredits.astro";

import BaseLayout from "../../layouts/BaseLayout.astro";

import { site } from "../../data/site";
import { ui, type Locale } from "../../i18n/ui";

import "../../styles/global.css";

interface Props {
  project: any;
  lang?: Locale;
  showEnglishOnly?: boolean;
}

const { project, lang = "en", showEnglishOnly = false } = Astro.props;

const t = ui[lang];

const { Content } = await render(project);

const canonical = `/projects/${project.id}/`;

const projectSchema = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",

  name: project.data.title,
  description: project.data.description,

  url: new URL(canonical, site.url).toString(),

  dateCreated: project.data.year,

  creator: {
    "@type": "Person",
    name: site.name,
    url: site.url,
  },

  about: project.data.category,
};
---

<BaseLayout
  title={`${project.data.title} — Yu Liu`}
  description={project.data.description}
  canonical={canonical}
  type="article"
  image={project.data.cover}
  schema={projectSchema}
  lang={lang}
>
  <Header lang={lang} />

  <main class="project-page">
    {
      showEnglishOnly && (
        <div class="language-notice">
          <div class="container">
            <p>{t.project.englishOnly}</p>
          </div>
        </div>
      )
    }

    <!-- =========================
         HERO
         ========================= -->

    <section class="project-hero">
      <div class="container">
        <p class="eyebrow">
          {project.data.year}
        </p>

        <h1 class="project-heading">
          {project.data.title}
        </h1>

        <p class="project-description">
          {project.data.description}
        </p>

        <div class="project-meta">
          {project.data.category.map((item: string) => <span>{item}</span>)}
        </div>
      </div>
    </section>

    <!-- =========================
         PROJECT CONTENT
         ========================= -->

    <section class="project-content">
      <div class="container content-grid">
        <article class="prose">
          <Content />
        </article>
      </div>
    </section>

    <!-- =========================
         CREDITS / PARTNERS
         ========================= -->

    {
      project.data.credits && (
        <section class="project-credits-section">
          <div class="container credits-container">
            <ProjectCredits credits={project.data.credits} />
          </div>
        </section>
      )
    }
  </main>

  <Footer />
</BaseLayout>

<style>
  /* =========================
     LANGUAGE NOTICE
     ========================= */

  .language-notice {
    padding-top: 1rem;
  }

  .language-notice p {
    margin: 0;

    color: var(--muted);

    font-size: 0.85rem;
  }

  /* =========================
     PAGE
     ========================= */

  .project-page {
    min-height: 100vh;

    padding-top: 7rem;

    background: #0a0a0a;
    color: #f5f5f5;
  }

  /* =========================
     HERO
     ========================= */

  .project-hero {
    padding-block: clamp(3rem, 7vw, 8rem);
  }

  .project-heading {
    max-width: 18ch;

    margin: 1.5rem 0 2rem;

    font-size: clamp(3rem, 8vw, 8rem);

    line-height: 0.92;

    letter-spacing: -0.055em;

    font-weight: 600;
  }

  .project-description {
    max-width: 44rem;

    margin: 0;

    color: var(--muted);

    font-size: var(--text-md);

    line-height: 1.2;
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;

    gap: 0.75rem;

    margin-top: 2rem;
  }

  .project-meta span {
    padding: 0.45rem 0.7rem;

    border: 1px solid var(--line);

    border-radius: 999px;

    color: var(--muted);

    font-size: var(--text-xs);
  }

  /* =========================
     CONTENT
     ========================= */

  .project-content {
    padding-block: 2rem var(--section-gap);
  }

  .content-grid {
    display: grid;

    grid-template-columns: minmax(0, 1fr);
  }

  .prose {
    max-width: 52rem;
  }

  .prose :global(h2) {
    margin: 4rem 0 1.25rem;

    font-size: clamp(2rem, 4vw, 4rem);

    line-height: 1;

    letter-spacing: -0.04em;
  }

  .prose :global(p) {
    margin: 0 0 1.5rem;

    color: var(--muted);

    font-size: var(--text-body);

    line-height: 1.65;
  }

  /* =========================
     PROJECT CREDITS
     ========================= */

  .project-credits-section {
    padding-bottom: clamp(5rem, 8vw, 8rem);
  }

  .credits-container {
    max-width: 52rem;
  }

  /* =========================
     HERO VIDEO
     ========================= */

  .prose :global(.hero-video) {
    width: 100%;

    margin: 2.5rem 0 4rem;
  }

  /* =========================
     VIDEO SWITCHER
     ========================= */

  .prose :global(.demo-links) {
    display: flex;
    flex-wrap: wrap;

    gap: 0.75rem;

    margin: -0.5rem 0 2rem;
  }

  .prose :global(.video-switch) {
    appearance: none;

    padding: 0.5rem 0.8rem;

    border: 1px solid var(--line);

    background: transparent;

    color: var(--muted);

    font: inherit;
    font-size: var(--text-xs);

    cursor: pointer;

    transition:
      color 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease;
  }

  .prose :global(.video-switch:hover),
  .prose :global(.video-switch.active) {
    color: var(--text);

    border-color: var(--text);
  }

  /* =========================
     VIDEO FRAME
     ========================= */

  .prose :global(.video-frame) {
    position: relative;

    width: 100%;

    aspect-ratio: 16 / 9;

    overflow: hidden;

    background: #111;
  }

  .prose :global(.video-frame iframe) {
    position: absolute;

    inset: 0;

    width: 100%;
    height: 100%;

    border: 0;
  }

  /* =========================
     DEMO LINKS
     ========================= */

  .prose :global(.demo-link) {
    display: inline-flex;

    align-items: center;

    padding: 0.55rem 0.8rem;

    border: 1px solid var(--line);

    border-radius: 999px;

    color: var(--muted);

    font-size: var(--text-xs);

    line-height: 1;

    text-decoration: none;

    transition:
      color 180ms ease,
      border-color 180ms ease;
  }

  .prose :global(.demo-link:hover) {
    color: var(--text);

    border-color: var(--text);
  }

  .prose :global(.demo-link[href=""]) {
    display: none;
  }

  /* =========================
     FIGURE NOTE
     ========================= */

  :global(.figure-note) {
    margin-top: 0.75rem;

    color: #8f8f8f;

    font-size: 0.75rem !important;

    line-height: 1.5 !important;
  }

  :global(.figure-note a) {
    color: #6ec8ff;

    font-size: inherit !important;

    text-decoration: underline;

    text-underline-offset: 3px;
  }

  :global(.figure-note a:hover) {
    color: #fff;
  }

  /* =========================
     MOBILE
     ========================= */

  @media (max-width: 768px) {
    .project-page {
      padding-top: 5rem;
    }

    .project-heading {
      max-width: none;
    }

    .project-content {
      padding-bottom: 5rem;
    }

    .project-credits-section {
      padding-bottom: 5rem;
    }

    .credits-container {
      max-width: none;
    }
  }
</style>
