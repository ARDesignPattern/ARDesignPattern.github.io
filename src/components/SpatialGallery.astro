---
interface GalleryItem {
  image: string;
  label?: string;
  alt?: string;
}

interface Props {
  items: GalleryItem[];
}

const { items } = Astro.props;
---

<div class="spatial-gallery" data-spatial-gallery>
  <div class="spatial-gallery-viewport">
    <div class="spatial-gallery-track" data-gallery-track>
      {
        items.map((item, index) => (
          <figure
            class="spatial-gallery-card"
            style={`--gallery-index: ${index}`}
            data-gallery-card
            tabindex="0"
            role="button"
            aria-pressed="false"
          >
            <div class="spatial-gallery-image-wrap">
              <img
                src={item.image}
                alt={item.alt ?? item.label ?? ""}
                loading="lazy"
                decoding="async"
              />
            </div>

            {item.label && <figcaption>{item.label}</figcaption>}
          </figure>
        ))
      }
    </div>
  </div>
</div>

<script>
  const galleries = document.querySelectorAll("[data-spatial-gallery]");

  galleries.forEach((gallery) => {
    if (!(gallery instanceof HTMLElement)) return;

    const track = gallery.querySelector("[data-gallery-track]");

    const cards = gallery.querySelectorAll("[data-gallery-card]");

    if (!(track instanceof HTMLElement)) return;

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const desktopQuery = window.matchMedia("(min-width: 769px)");

    let animationFrame = 0;

    let targetX = 0;
    let currentX = 0;
    let maxOffset = 0;

    let pointerAmount = -1;

    let isVisible = false;
    let isPointerInside = false;
    let hasPointerMoved = false;

    const lerp = (start: number, end: number, amount: number): number => {
      return start + (end - start) * amount;
    };

    /* =========================
       GALLERY BOUNDS
       ========================= */

    const calculateBounds = () => {
      if (!desktopQuery.matches) {
        targetX = 0;
        currentX = 0;

        track.style.transform = "";

        return;
      }

      const galleryWidth = gallery.clientWidth;
      const trackWidth = track.scrollWidth;

      maxOffset = Math.max(0, trackWidth - galleryWidth);

      currentX = Math.max(-maxOffset, Math.min(0, currentX));

      targetX = Math.max(-maxOffset, Math.min(0, targetX));
    };

    /* =========================
       POINTER → TARGET POSITION
       ========================= */

    const updateTarget = () => {
      if (!desktopQuery.matches || reducedMotion.matches) {
        targetX = 0;
        return;
      }

      if (maxOffset <= 0) {
        targetX = 0;
        return;
      }

      /*
        Do not automatically center the gallery
        before the user actually moves the pointer.

        Initial state = beginning of gallery.
      */

      if (!hasPointerMoved) {
        targetX = 0;
        return;
      }

      /*
        pointerAmount:
        -1 = pointer at left
         0 = pointer at center
         1 = pointer at right

        Gallery moves in the opposite direction.
      */

      const normalized = (pointerAmount + 1) / 2;

      targetX = -maxOffset * normalized;
    };

    /* =========================
       SMOOTH RAF ANIMATION
       ========================= */

    const animate = () => {
      if (!desktopQuery.matches || reducedMotion.matches || !isVisible) {
        animationFrame = 0;
        return;
      }

      /*
        Smaller value = slower / softer inertia.
      */

      currentX = lerp(currentX, targetX, 0.045);

      track.style.transform = `translate3d(${currentX}px, 0, 0)`;

      const distance = Math.abs(targetX - currentX);

      if (distance > 0.1 || isPointerInside) {
        animationFrame = requestAnimationFrame(animate);
      } else {
        animationFrame = 0;
      }
    };

    const startAnimation = () => {
      if (animationFrame) return;

      animationFrame = requestAnimationFrame(animate);
    };

    /* =========================
       POINTER CONTROL
       ========================= */

    gallery.addEventListener("pointerenter", () => {
      if (!desktopQuery.matches) return;

      isPointerInside = true;
      startAnimation();
    });

    gallery.addEventListener("pointerleave", () => {
      isPointerInside = false;
    });

    gallery.addEventListener("pointermove", (event) => {
      if (!desktopQuery.matches || reducedMotion.matches) {
        return;
      }

      const rect = gallery.getBoundingClientRect();

      const x = event.clientX - rect.left;

      pointerAmount = Math.max(-1, Math.min(1, (x / rect.width) * 2 - 1));

      hasPointerMoved = true;

      updateTarget();
      startAnimation();
    });

    /* =========================
       CLICK / KEYBOARD FOCUS
       ========================= */

    const selectCard = (selectedCard: Element) => {
      if (!(selectedCard instanceof HTMLElement)) {
        return;
      }

      const alreadySelected = selectedCard.classList.contains("is-selected");

      cards.forEach((card) => {
        if (!(card instanceof HTMLElement)) {
          return;
        }

        card.classList.remove("is-selected");

        card.setAttribute("aria-pressed", "false");
      });

      /*
        Clicking the currently selected card
        closes it again.
      */

      if (!alreadySelected) {
        selectedCard.classList.add("is-selected");

        selectedCard.setAttribute("aria-pressed", "true");
      }
    };

    cards.forEach((card) => {
      card.addEventListener("click", () => {
        selectCard(card);
      });

      card.addEventListener("keydown", (event) => {
        if (!(event instanceof KeyboardEvent)) {
          return;
        }

        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          selectCard(card);
        }
      });
    });

    /* =========================
       RESIZE
       ========================= */

    const resizeObserver = new ResizeObserver(() => {
      calculateBounds();
      updateTarget();
      startAnimation();
    });

    resizeObserver.observe(gallery);
    resizeObserver.observe(track);

    /* =========================
       VIEWPORT VISIBILITY
       ========================= */

    const intersectionObserver = new IntersectionObserver(
      ([entry]) => {
        isVisible = entry?.isIntersecting ?? false;

        if (isVisible) {
          calculateBounds();
          updateTarget();
          startAnimation();
        }
      },
      {
        threshold: 0.05,
      },
    );

    intersectionObserver.observe(gallery);

    /* =========================
       RESPONSIVE / REDUCED MOTION
       ========================= */

    const handleMediaChange = () => {
      calculateBounds();
      updateTarget();

      if (desktopQuery.matches && !reducedMotion.matches) {
        startAnimation();
      }
    };

    desktopQuery.addEventListener("change", handleMediaChange);

    reducedMotion.addEventListener("change", handleMediaChange);

    /* =========================
       INITIAL STATE
       ========================= */

    calculateBounds();
    updateTarget();
  });
</script>

<style>
  /* =========================
     GALLERY SHELL
     ========================= */

  .spatial-gallery {
    width: 100%;
    overflow: hidden;
  }

  .spatial-gallery-viewport {
    width: 100%;
    overflow: hidden;
  }

  /* =========================
     TRACK
     ========================= */

  .spatial-gallery-track {
    display: flex;
    align-items: center;

    gap: clamp(0.9rem, 1.35vw, 1.5rem);

    width: max-content;

    /*
      Extra vertical breathing room for
      hover and selected states.
    */
    padding-top: 4rem;
    padding-bottom: 4rem;

    padding-inline: max(var(--page-padding), calc((100vw - 1480px) / 2));

    will-change: transform;
  }

  /* =========================
     CARD
     ========================= */

  .spatial-gallery-card {
    position: relative;

    /*
      Default state:
      narrow editorial portrait card.
    */
    width: clamp(190px, 14.5vw, 270px);

    margin: 0;

    flex: 0 0 auto;

    z-index: 1;

    cursor: pointer;

    /*
      Tiny vertical offsets create
      restrained spatial irregularity.
    */
    transform: translateY(calc((var(--gallery-index) % 3) * 8px));

    transition:
      transform 220ms ease,
      opacity 200ms ease;
  }

  /* =========================
     IMAGE FRAME
     ========================= */

  .spatial-gallery-image-wrap {
    position: relative;

    /*
      Default:
      very narrow vertical crop.
    */
    aspect-ratio: 5 / 5;

    overflow: hidden;

    border-radius: 0.3rem;

    background: #111;

    border: 1px solid rgba(255, 255, 255, 0.08);

    transition:
      border-color 300ms ease,
      transform 350ms cubic-bezier(0.2, 0.75, 0.25, 1);
  }

  .spatial-gallery-image-wrap::after {
    content: "";

    position: absolute;
    inset: 0;

    pointer-events: none;

    border: 1px solid rgba(255, 255, 255, 0);

    transition: border-color 300ms ease;
  }

  /* =========================
     IMAGE
     ========================= */

  .spatial-gallery-card img {
    display: block;

    width: 100%;
    height: 100%;

    /*
      Default cards intentionally crop.
    */
    object-fit: cover;
    object-position: center;

    filter: brightness(0.6) saturate(0.3) contrast(1);

    transform: scale(1.001);

    transition:
      filter 400ms ease,
      transform 450ms cubic-bezier(0.2, 0.75, 0.25, 1);
  }

  /* =========================
     LABEL
     ========================= */

  .spatial-gallery-card figcaption {
    margin-top: 0.8rem;

    color: rgba(255, 255, 255, 0.4);

    font-size: 0.75rem;
    line-height: 1.3;

    letter-spacing: 0.02em;

    transition:
      color 250ms ease,
      transform 250ms ease;
  }

  /* =========================
     DESKTOP HOVER
     ========================= */

  @media (hover: hover) and (pointer: fine) {
    .spatial-gallery-card:not(.is-selected):hover {
      transform: translateY(calc((var(--gallery-index) % 3) * 8px - 4px));
    }

    .spatial-gallery-card:not(.is-selected):hover .spatial-gallery-image-wrap {
      transform: scale(1.018);

      border-color: rgba(255, 255, 255, 0.16);
    }

    .spatial-gallery-card:not(.is-selected):hover
      .spatial-gallery-image-wrap::after {
      border-color: rgba(255, 255, 255, 0.07);
    }

    .spatial-gallery-card:not(.is-selected):hover img {
      filter: brightness(1) saturate(1);

      transform: scale(1.022);
    }

    .spatial-gallery-card:not(.is-selected):hover figcaption {
      color: rgba(255, 255, 255, 0.82);

      transform: translateY(-1px);
    }
  }

  /* =========================
     SELECTED / CLICKED CARD
     ========================= */

  .spatial-gallery-card.is-selected {
    width: clamp(420px, 42vw, 760px);

    z-index: 20;

    transform: none;
  }

  .spatial-gallery-card.is-selected .spatial-gallery-image-wrap {
    /*
      Selected state becomes a large
      landscape presentation frame.
    */
    aspect-ratio: 16 / 9;

    background: #000;

    border-color: rgba(255, 255, 255, 0.22);

    transform: none;
  }

  .spatial-gallery-card.is-selected .spatial-gallery-image-wrap::after {
    border-color: rgba(255, 255, 255, 0.08);
  }

  .spatial-gallery-card.is-selected img {
    /*
      The complete original image is shown.
      No cropping in selected state.
    */
    object-fit: contain;
    object-position: center;

    filter: brightness(1) saturate(1);

    transform: none;
  }

  .spatial-gallery-card.is-selected figcaption {
    color: rgba(255, 255, 255, 0.95);

    transform: none;
  }

  /* =========================
     KEYBOARD FOCUS
     ========================= */

  .spatial-gallery-card:focus-visible {
    outline: 1px solid rgba(255, 255, 255, 0.65);

    outline-offset: 6px;
  }

  /* =========================
     MOBILE
     ========================= */

  @media (max-width: 768px) {
    .spatial-gallery {
      overflow: visible;
    }

    .spatial-gallery-viewport {
      overflow-x: auto;
      overflow-y: hidden;

      scroll-snap-type: x mandatory;

      overscroll-behavior-inline: contain;

      scrollbar-width: none;

      -webkit-overflow-scrolling: touch;
    }

    .spatial-gallery-viewport::-webkit-scrollbar {
      display: none;
    }

    .spatial-gallery-track {
      gap: 1rem;

      padding-top: 1.5rem;
      padding-bottom: 1.5rem;

      padding-inline: var(--page-padding);

      transform: none !important;

      will-change: auto;
    }

    .spatial-gallery-card {
      width: 76vw;
      max-width: 340px;

      scroll-snap-align: center;

      transform: none;

      cursor: default;
    }

    .spatial-gallery-image-wrap {
      /*
        Less extreme ratio on phones.
      */
      aspect-ratio: 3 / 5;
    }

    .spatial-gallery-card img {
      filter: brightness(0.9) saturate(0.9);

      transform: none;
    }

    /*
      Disable the desktop expansion model
      on touch devices.
    */

    .spatial-gallery-card.is-selected {
      width: 76vw;
      max-width: 340px;

      transform: none;
    }

    .spatial-gallery-card.is-selected .spatial-gallery-image-wrap {
      aspect-ratio: 3 / 5;

      border-color: rgba(255, 255, 255, 0.08);
    }

    .spatial-gallery-card.is-selected img {
      object-fit: cover;

      filter: brightness(0.9) saturate(0.9);

      transform: none;
    }
  }

  /* =========================
     REDUCED MOTION
     ========================= */

  @media (prefers-reduced-motion: reduce) {
    .spatial-gallery-track {
      transform: none !important;
      will-change: auto;
    }

    .spatial-gallery-card,
    .spatial-gallery-image-wrap,
    .spatial-gallery-card img,
    .spatial-gallery-card figcaption {
      transition: none;
    }

    .spatial-gallery-card.is-selected {
      transform: none;
    }
  }
</style>
