---
import { getCollection } from "astro:content";
import ProjectPage from "../../components/pages/ProjectPage.astro";
import WorkProjectPage from "../../components/pages/WorkProjectPage.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;

const isWorkProject = project.data.template === "work";
---

{
  isWorkProject ? (
    <WorkProjectPage project={project} />
  ) : (
    <ProjectPage project={project} />
  )
}
