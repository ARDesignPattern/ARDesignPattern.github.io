---
import { getCollection } from "astro:content";
import ProjectPage from "../../../components/pages/ProjectPage.astro";
import WorkProjectPage from "../../../components/pages/WorkProjectPage.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return ["de", "zh"].flatMap((lang) =>
    projects.map((project) => ({
      params: {
        lang,
        id: project.id,
      },
      props: {
        project,
        lang,
      },
    })),
  );
}

const { project } = Astro.props;
const lang = Astro.props.lang as "de" | "zh";

const isWorkProject = project.data.template === "work";
---

{
  isWorkProject ? (
    <WorkProjectPage project={project} lang={lang} />
  ) : (
    <ProjectPage project={project} lang={lang} showEnglishOnly={true} />
  )
}
