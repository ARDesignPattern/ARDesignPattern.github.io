---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
import "../styles/global.css";
---

<BaseLayout
  title="About Yu Liu — Interaction Designer & HCI/XR Researcher"
  description="Learn more about Yu Liu's background in industrial design, interaction design, HCI, XR research, prototyping, and immersive experiences."
>
  <Header />

  <main class="about-page">
    <section class="about-hero">
      <div class="container">
        <p class="eyebrow">About</p>

        <h1 class="about-title">
          Designing across interaction, space, and emerging technology.
        </h1>

        <p class="about-intro">
          I am an interaction designer and HCI/XR researcher working across
          immersive technology, prototyping, user research, and design research.
        </p>
      </div>
    </section>

    <section class="about-section">
      <div class="container about-grid">
        <div>
          <p class="eyebrow">Background</p>
        </div>

        <div class="about-copy">
          <p>
            My background spans industrial design, interaction design, product
            development, and XR research. I am interested in how digital
            experiences can become more spatial, intuitive, and meaningful in
            real-world environments.
          </p>

          <p>
            Over time, my work has moved from physical product and visual design
            toward human-computer interaction, augmented reality, and immersive
            systems. This combination of design and research shapes how I
            approach complex interaction problems today.
          </p>
        </div>
      </div>
    </section>

    <section class="about-section">
      <div class="container about-grid">
        <div>
          <p class="eyebrow">What I Do</p>
        </div>

        <div class="expertise-list">
          <div class="expertise-row">
            <span>01</span>
            <h2>Interaction Design</h2>
          </div>

          <div class="expertise-row">
            <span>02</span>
            <h2>XR / AR Experiences</h2>
          </div>

          <div class="expertise-row">
            <span>03</span>
            <h2>HCI & UX Research</h2>
          </div>

          <div class="expertise-row">
            <span>04</span>
            <h2>Prototyping & Design Research</h2>
          </div>
        </div>
      </div>
    </section>

    <section class="about-section">
      <div class="container about-grid">
        <div>
          <p class="eyebrow">Approach</p>
        </div>

        <div class="about-copy">
          <p>
            I combine design practice with empirical research. I prototype
            interactive systems, deploy them in real environments, observe how
            people use them, and translate those findings into reusable design
            knowledge.
          </p>

          <p>
            Much of my recent work focuses on head-mounted AR, spatial
            interaction, museum experiences, and interaction design patterns for
            first-time users.
          </p>
        </div>
      </div>
    </section>

    <section class="about-section contact-section">
      <div class="container about-grid">
        <div>
          <p class="eyebrow">Contact</p>
        </div>

        <div>
          <p class="contact-lead">
            Interested in collaboration, research, design, or XR projects?
          </p>

          <a class="contact-link" href={`mailto:${site.email}`}>
            {site.email} ↗
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .about-page {
    padding-top: 7rem;
  }

  .about-hero {
    padding-block: clamp(4rem, 9vw, 9rem);
  }

  .about-title {
    max-width: 15ch;
    margin: 1.5rem 0 2rem;
    font-size: clamp(3.2rem, 7vw, 7.5rem);
    line-height: 0.95;
    letter-spacing: -0.055em;
    font-weight: 600;
  }

  .about-intro {
    max-width: 42rem;
    margin: 0;
    font-size: var(--text-md);
    line-height: 1.25;
    color: var(--muted);
  }

  .about-section {
    padding-block: clamp(4rem, 8vw, 8rem);
    border-top: 1px solid var(--line);
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(10rem, 0.7fr) minmax(0, 1.8fr);
    gap: clamp(2rem, 6vw, 7rem);
  }

  .about-copy {
    max-width: 48rem;
  }

  .about-copy p {
    margin: 0 0 1.5rem;
    font-size: var(--text-body);
    line-height: 1.65;
    color: var(--muted);
  }

  .expertise-list {
    border-top: 1px solid var(--line);
  }

  .expertise-row {
    display: grid;
    grid-template-columns: 4rem 1fr;
    align-items: center;
    gap: 1rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .expertise-row span {
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .expertise-row h2 {
    margin: 0;
    font-size: clamp(1.8rem, 3.6vw, 4rem);
    line-height: 1;
    letter-spacing: -0.04em;
    font-weight: 500;
  }

  .contact-lead {
    max-width: 34rem;
    margin: 0 0 1.5rem;
    font-size: var(--text-md);
    line-height: 1.25;
  }

  .contact-link {
    font-size: var(--text-body);
    color: var(--text);
  }

  @media (max-width: 768px) {
    .about-page {
      padding-top: 5rem;
    }

    .about-title {
      max-width: none;
    }

    .about-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
